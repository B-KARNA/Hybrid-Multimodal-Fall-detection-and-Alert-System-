# ============================================================
# Dockerfile.backend - Alert Manager & Outdoor Sensor Service
# ============================================================
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

WORKDIR /app

# Install system dependencies (curl for healthcheck)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY docker/requirements-backend.txt /tmp/requirements-backend.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/requirements-backend.txt

# Copy backend application source code and models
COPY Hybrid-Multimodel-Fall-Detection-System/ /app/

# Expose Alert Manager (8002) and Sensor Service (8000)
EXPOSE 8000 8002

# Default command runs the Centralized Alert Manager
CMD ["python", "-m", "src.alerting.alert_manager"]
