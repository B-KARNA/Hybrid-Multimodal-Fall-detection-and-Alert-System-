# Build context filter for every image in deploy/ and root Dockerfile
# Keeps the build context sent to Docker daemon minimal and fast.

# Python build artefacts
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/
env/

# Version control & repo metadata
.git/
.gitignore
.gitattributes
.dockerignore
.backend_git_backup/

# Android mobile app (not needed by container images)
FallAlert/

# Documentation and large media files
DOCUMENTATION.*
*.pdf
Supplementary.pdf
structure.txt
AWS_DEPLOYMENT_GUIDE.md
README.md

# Secrets & Keys
.env
*.pem

# Non-runtime data & logs
baseline/
data/
datasets/
logs/
notebooks/
scratch/
scratch_*.py

# Root-level duplicates of files that already live under models/
yolo11n-pose.pt
pose_landmarker_lite.task
vision_fall_model.pkl
imumodel.py
visionmodel.py

# Scratch & OS
*.log
*.tmp
.DS_Store
Thumbs.db
