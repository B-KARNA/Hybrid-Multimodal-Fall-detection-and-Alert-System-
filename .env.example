# ============================================================
# HMFDA Cloud Deployment Environment Configuration
# ============================================================

# Ports
ALERT_MANAGER_PORT=8002
SENSOR_PORT=8000
DASHBOARD_PORT=8501
HTTP_PORT=80

# Internal Network Routing (Within Docker Compose)
OUTDOOR_DETECTOR_URL=http://sensor-service:8000
ALERT_MANAGER_URL=http://alert-manager:8002

# Alert Engine Tuning
ALERT_HOLD_SECONDS=30
FALL_HOLD_SECONDS=30
SOURCE_COOLDOWN_SECONDS=20

# Optional Twilio Credentials for Automated Emergency SMS Dispatch
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TARGET_PHONE_NUMBER=
